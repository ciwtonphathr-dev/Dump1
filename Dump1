local function getViewport()
    local cam = workspace.CurrentCamera
    return (cam and cam.ViewportSize) or Vector2.new(1280, 720)
end

local function getDeviceKind()
    local vp = getViewport()
    local shortest = math.min(vp.X, vp.Y)
    local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
    if shortest <= 500 or (touch and vp.Y > vp.X) then return "phone" end
    if shortest <= 900 then return "tablet" end
    return "desktop"
end

local function getResponsiveSize()
    local vp = getViewport()
    local kind = getDeviceKind()
    local w, h
    if kind == "phone" then
        if vp.Y > vp.X then
            w = math.clamp(math.floor(vp.X * 0.75), 240, 340)
            h = math.clamp(math.floor(vp.Y * 0.55), 320, 480)
        else
            w = math.clamp(math.floor(vp.X * 0.45), 300, 420)
            h = math.clamp(math.floor(vp.Y * 0.80), 260, 380)
        end
    elseif kind == "tablet" then
        w = math.clamp(math.floor(vp.X * 0.55), 360, 500)
        h = math.clamp(math.floor(vp.Y * 0.55), 400, 560)
    else
        w = math.clamp(math.floor(vp.X * 0.30), 400, 500)
        h = math.clamp(math.floor(vp.Y * 0.62), 440, 600)
    end
    return UDim2.fromOffset(w, h)
end

