-- MODULE 8: Deep Scan
-- ===================================================================================
local function extractScript(obj, svc)
    stat.scripts = stat.scripts + 1
    if obj:IsA("ModuleScript") then stat.modules = stat.modules + 1 end
    local src = getScriptSource(obj)
    if not src then
        src = "-- [Protected / Unable to extract]\n-- Class: " .. obj.ClassName
              .. "\n-- Path: " .. obj:GetFullName() .. "\n"
    end
    queueWrite(svc .. "/" .. relativeUnder(obj, svc) .. ".lua", src)
end

local function extractRemote(obj, svc)
    stat.remotes = stat.remotes + 1
    local body = table.concat({
        "ClassName: " .. obj.ClassName,
        "Name: " .. obj.Name,
        "Path: " .. obj:GetFullName(),
        "Parent: " .. (obj.Parent and obj.Parent:GetFullName() or "nil"),
        "---",
        "Use: hook via __namecall / FireServer / InvokeServer"
    }, "\n")
    queueWrite("Remote/" .. svc .. "/" .. relativeUnder(obj, svc) .. ".remote.txt", body)
end

local function extractGui(obj, svc)
    stat.gui = stat.gui + 1
    local body = table.concat({
        "ClassName: " .. obj.ClassName,
        "Name: " .. obj.Name,
        "Path: " .. obj:GetFullName(),
        "Parent: " .. (obj.Parent and obj.Parent:GetFullName() or "nil")
    }, "\n")
    queueWrite("Gui/" .. svc .. "/" .. relativeUnder(obj, svc) .. ".gui.txt", body)
end

local function deepWalk(obj, svc)
    if not obj then return end
    if ignoreNames[obj.Name] then return end

    pcall(function()
        if obj:IsA("LocalScript") or obj:IsA("Script") or obj:IsA("ModuleScript") then
            extractScript(obj, svc)
        elseif obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")
            or obj:IsA("BindableEvent") or obj:IsA("BindableFunction")
            or obj:IsA("UnreliableRemoteEvent") then
            extractRemote(obj, svc)
        elseif obj:IsA("ScreenGui") or obj:IsA("GuiObject") then
            extractGui(obj, svc)
        elseif obj:IsA("ValueBase") then
            stat.values = stat.values + 1
        elseif obj:IsA("Humanoid") then
            stat.humanoids = stat.humanoids + 1
        elseif obj:IsA("Tool") then
            stat.tools = stat.tools + 1
        elseif obj:IsA("BasePart") then
            stat.parts = stat.parts + 1
        end
    end)

    local total = stat.scripts + stat.remotes + stat.gui
    if total > 0 and total % 5 == 0 then
        updateStatus(string.format("Scanning...\nS:%d R:%d G:%d F:%d",
            stat.scripts, stat.remotes, stat.gui, stat.files))
        task.wait(0.02)
    end

    local ok, children = pcall(function() return obj:GetChildren() end)
    if not ok or not children then return end
    for i, child in ipairs(children) do
        deepWalk(child, svc)
        if i % 8 == 0 then task.wait() end
    end
end

local function buildDumpRoot()
    local placeName = "Game"
    pcall(function()
        placeName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
    end)
    placeName = sanitizeName(placeName)
    return string.format("%s/%s [%d]", FOLDER_NAME, placeName, game.PlaceId)
end

local function startScan()
    if isScanning then return end
    if not writefile or not makefolder then
        updateStatus("ERROR\nNeed writefile + makefolder")
        addLog("Executor missing writefile/makefolder")
        return
    end

    isScanning = true
    for k in pairs(stat) do stat[k] = 0 end
    pendingWrites = {}
    canDump = false
    setDumpEnabled(false)

    dumpRoot = buildDumpRoot()
    pcall(makefolder, FOLDER_NAME)
    ensureDir(dumpRoot)

    ScanBtn.Text = "SCANNING..."
    tween(ScanBtn, {BackgroundColor3 = Color3.fromRGB(60, 40, 90)}, 0.2)
    LogText.Text = "• Deep scan started"
    updateStatus("Phase 1\nBuilding tree...")
    setProgress(true, 0.05)
    pulseStroke(MainStroke)

    task.spawn(function()
        local targets = {
            {game:GetService("ReplicatedStorage"), "ReplicatedStorage"},
            {game:GetService("ReplicatedFirst"), "ReplicatedFirst"},
            {game:GetService("StarterPlayer"), "StarterPlayer"},
            {game:GetService("StarterGui"), "StarterGui"},
            {game:GetService("StarterPack"), "StarterPack"},
            {LocalPlayer:FindFirstChild("PlayerGui"), "LocalPlayer/PlayerGui"},
            {LocalPlayer:FindFirstChild("PlayerScripts"), "LocalPlayer/PlayerScripts"},
            {LocalPlayer:FindFirstChild("Backpack"), "LocalPlayer/Backpack"},
            {LocalPlayer.Character, "LocalPlayer/Character"},
            {workspace, "Workspace"},
            {game:GetService("Players"), "Players"},
            {game:GetService("Lighting"), "Lighting"},
            {game:GetService("SoundService"), "SoundService"},
            {game:GetService("Chat"), "Chat"},
            {game:GetService("TextChatService"), "TextChatService"},
            {game:GetService("Teams"), "Teams"},
            {game:GetService("CoreGui"), "CoreGui"},
        }

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                table.insert(targets, {plr.Character, "Workspace/" .. sanitizeName(plr.Name)})
            end
        end

        local total = #targets
        for i, data in ipairs(targets) do
            local obj, name = data[1], data[2]
            if obj then
                updateStatus(string.format("Scan %d/%d\n%s", i, total, name))
                addLog(name)
                setProgress(true, 0.05 + (i / total) * 0.8)
                local svc = name:match("^([^/]+)") or name
                pcall(deepWalk, obj, svc)
            end
            task.wait(0.04)
        end

        local summary = {
            "=== WROM HUB DEEP DUMP ===",
            "PlaceId: " .. tostring(game.PlaceId),
            "JobId: " .. tostring(game.JobId),
            "Generated: " .. os.date("%Y-%m-%d %H:%M:%S"),
            "",
            "Scripts: " .. stat.scripts,
            "  Modules: " .. stat.modules,
            "Remotes: " .. stat.remotes,
            "GUI objects: " .. stat.gui,
            "Values: " .. stat.values,
            "Humanoids: " .. stat.humanoids,
            "Tools: " .. stat.tools,
            "Parts: " .. stat.parts,
            "Files queued: " .. stat.files,
            "",
            "Structure:",
            "  " .. dumpRoot .. "/ReplicatedStorage/...",
            "  " .. dumpRoot .. "/Remote/<Service>/...",
            "  " .. dumpRoot .. "/Gui/<Service>/...",
            "",
            "Press DUMP to write all files.",
        }
        queueWrite("_SUMMARY.txt", table.concat(summary, "\n"))

        isScanning = false
        ScanBtn.Text = "SCAN"
        tween(ScanBtn, {BackgroundColor3 = Color3.fromRGB(120, 60, 200)}, 0.25)
        setDumpEnabled(true)
        setProgress(true, 1)
        stopPulse()
        task.wait(0.25)
        setProgress(false, 0)

        updateStatus(string.format("Done!\nS:%d R:%d G:%d F:%d",
            stat.scripts, stat.remotes, stat.gui, stat.files))
        addLog(string.format("Ready: %d files", stat.files))
    end)
end

-- ===================================================================================
-- MODULE 9: Dump
-- ===================================================================================
local function doDump()
    if not canDump or #pendingWrites == 0 then return end
    if not writefile then
        updateStatus("ERROR\nNo writefile")
        return
    end

    DumpBtn.Text = "WRITING..."
    DumpBtn.Active = false
    updateStatus("Writing files...\n0 / " .. #pendingWrites)
    addLog("Writing " .. #pendingWrites .. " files")

    task.spawn(function()
        local total = #pendingWrites
        local written = 0
        for i, item in ipairs(pendingWrites) do
            local dir = item.path:match("(.+)/[^/]+$")
            if dir then ensureDir(dir) end
            pcall(writefile, item.path, item.content)
            written = written + 1
            if i % 5 == 0 or i == total then
                updateStatus(string.format("Writing...\n%d / %d", written, total))
                setProgress(true, written / total)
                task.wait()
            end
        end

        setProgress(false, 0)
        DumpBtn.Text = "DUMP"
        DumpBtn.Active = true
        updateStatus("SUCCESS!\n" .. dumpRoot)
        addLog("Saved -> " .. dumpRoot)
        tween(MainStroke, {Color = Color3.fromRGB(50, 220, 120)}, 0.2)
        task.delay(1.2, function()
            tween(MainStroke, {Color = Color3.fromRGB(150, 60, 220)}, 0.4)
        end)
    end)
end

