local function sanitizeName(name)
    name = tostring(name or "unnamed")
    name = name:gsub("[\\/:*?\"<>|]", "_")
    name = name:gsub("%s+", " ")
    if #name > 80 then name = name:sub(1, 80) end
    if name == "" or name == "." or name == ".." then name = "unnamed" end
    return name
end

local ensureDirCache = {}
local function ensureDir(path)
    if not makefolder then return end
    if ensureDirCache[path] then return end
    ensureDirCache[path] = true
    local parts = {}
    for part in string.gmatch(path, "[^/]+") do
        table.insert(parts, part)
        pcall(makefolder, table.concat(parts, "/"))
    end
end

local pathCache = setmetatable({}, {__mode = "k"})
local function getRelPath(obj, svc)
    local cached = pathCache[obj]
    if cached then return cached end
    local full = obj:GetFullName()
    local pat = "^game%." .. svc .. "%.?"
    local rel = full:gsub(pat, "")
    if rel == full then
        pat = "^" .. svc .. "%.?"
        rel = full:gsub(pat, "")
    end
    if rel == "" or rel == full then
        rel = sanitizeName(obj.Name)
    else
        local parts = {}
        for p in string.gmatch(rel, "[^%.]+") do
            table.insert(parts, sanitizeName(p))
        end
        rel = table.concat(parts, "/")
    end
    pathCache[obj] = rel
    return rel
end

