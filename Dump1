pcall(function()
    local old_info = debug.info
    debug.info = function(level, ...)
        if not checkcaller() then
            local info = old_info(level, ...)
            if type(info) == "table" then
                local fake = {}
                for k, v in pairs(info) do
                    if k == "source" then fake[k] = "builtin"
                    elseif k == "short_src" then fake[k] = "=[C]"
                    elseif k == "linedefined" or k == "lastlinedefined" then fake[k] = 0
                    else fake[k] = v end
                end
                return fake
            end
            return info
        end
        return old_info(level, ...)
    end
end)

