    task.spawn(function()
        while #writeQueue > 0 do
            local item = table.remove(writeQueue, 1)
            if item then
                local dir = item.path:match("(.+)/[^/]+$")
                if dir then ensureDir(dir) end
                pcall(writefile, item.path, item.content)
                writeCount = writeCount + 1
            end
            task.wait(0.02)
        end
        DumpBtn.Text = "DUMP"
        DumpBtn.Active = true
        StatusText.Text = "SUCCESS!\n" .. dumpRoot
        addLog("Saved -> " .. dumpRoot)
    end)
end)

