local function sanitizeName(name)
    name = tostring(name or "unnamed")
    name = name:gsub("[\\/:*?\"<>|]", "_")
    name = name:gsub("%s+", " ")
    if #name > 80 then name = name:sub(1, 80) end
    if name == "" or name == "." or name == ".." then name = "unnamed" end
    return name
end

local function ensureDir(path)
    if not makefolder then return end
    local parts = {}
    for part in string.gmatch(path, "[^/]+") do
        table.insert(parts, part)
        pcall(makefolder, table.concat(parts, "/"))
    end
end

local function queueWrite(relPath, content)
    table.insert(pendingWrites, {path = dumpRoot .. "/" .. relPath, content = content or ""})
    stat.files = stat.files + 1
end

local function getScriptSource(obj)
    local src
    local ok, res = pcall(function()
        if decompile then return decompile(obj) end
    end)
    if ok and type(res) == "string" and #res > 0 then
        src = res
    else
        local ok2, res2 = pcall(function() return obj.Source end)
        if ok2 and type(res2) == "string" and #res2 > 0 then
            src = res2
        end
    end
    return src
end

local function relativeUnder(obj, serviceName)
    local full = obj:GetFullName()
    local pat = "^game%." .. serviceName .. "%.?"
    local rel = full:gsub(pat, "")
    if rel == full then
        pat = "^" .. serviceName .. "%.?"
        rel = full:gsub(pat, "")
    end
    if rel == "" or rel == full then
        return sanitizeName(obj.Name)
    end
    local parts = {}
    for p in string.gmatch(rel, "[^%.]+") do
        table.insert(parts, sanitizeName(p))
    end
    return table.concat(parts, "/")
end

-- ===================================================================================
-- MODULE 8: Ultra-Light Scanner (no freeze, controlled pace)
-- ===================================================================================
-- ปรับค่าตรงนี้ถ้ายังแล็ค: ลด MAX_DEPTH, เพิ่ม SLEEP_BETWEEN, เพิ่ม YIELD_EVERY
local MAX_DEPTH      = 4     -- ลึกสุดแค่ 4 ชั้น
local YIELD_EVERY    = 5     -- yield ทุก 5 objects
local SLEEP_BETWEEN  = 0.03  -- นอน 0.03 วิ ต่อ yield
local MAX_CHILDREN   = 3000  -- สแกนลูกได้สูงสุดต่อ parent

local function extractScript(obj, svc)
    stat.scripts = stat.scripts + 1
    if obj:IsA("ModuleScript") then stat.modules = stat.modules + 1 end
    local src = getScriptSource(obj)
    if not src then
        src = "-- [Protected]\n-- Class: " .. obj.ClassName
              .. "\n-- Path: " .. obj:GetFullName() .. "\n"
    end
    queueWrite(svc .. "/" .. relativeUnder(obj, svc) .. ".lua", src)
end

local function extractRemote(obj, svc)
    stat.remotes = stat.remotes + 1
    queueWrite("Remote/" .. svc .. "/" .. relativeUnder(obj, svc) .. ".remote.txt",
        "ClassName: " .. obj.ClassName ..
        "\nName: " .. obj.Name ..
        "\nPath: " .. obj:GetFullName() ..
        "\nParent: " .. (obj.Parent and obj.Parent:GetFullName() or "nil"))
end

local function extractGui(obj, svc)
    stat.gui = stat.gui + 1
    queueWrite("Gui/" .. svc .. "/" .. relativeUnder(obj, svc) .. ".gui.txt",
        "ClassName: " .. obj.ClassName ..
        "\nName: " .. obj.Name ..
        "\nPath: " .. obj:GetFullName())
end

-- ใช้ iterative BFS แทน recursive เพื่อไม่ให้สแต็กทับซ้อนและคุมจังหวะได้
local function scanTree(root, svc)
    local queue = {{obj = root, depth = 0}}
    local head = 1
    local processed = 0
    while head <= #queue do
        local node = queue[head]; head = head + 1
        local obj, depth = node.obj, node.depth
        if obj and depth <= MAX_DEPTH and not ignoreNames[obj.Name] then
            pcall(function()
                if obj:IsA("LocalScript") or obj:IsA("Script") or obj:IsA("ModuleScript") then
                    extractScript(obj, svc)
                elseif obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")
                    or obj:IsA("BindableEvent") or obj:IsA("BindableFunction") then
                    extractRemote(obj, svc)
                elseif obj:IsA("ScreenGui") then
                    extractGui(obj, svc)
                elseif obj:IsA("ValueBase") then
                    stat.values = stat.values + 1
                elseif obj:IsA("Humanoid") then
                    stat.humanoids = stat.humanoids + 1
                elseif obj:IsA("Tool") then
                    stat.tools = stat.tools + 1
                elseif obj:IsA("BasePart") then
                    stat.parts = stat.parts + 1
                end
            end)

            processed = processed + 1
            if processed % YIELD_EVERY == 0 then
                updateStatus(string.format("Scanning...\nS:%d R:%d F:%d",
                    stat.scripts, stat.remotes, stat.files))
                task.wait(SLEEP_BETWEEN)
            end

            if depth < MAX_DEPTH then
                local ok, children = pcall(function() return obj:GetChildren() end)
                if ok and children then
                    local lim = math.min(#children, MAX_CHILDREN)
                    for i = 1, lim do
                        queue[#queue + 1] = {obj = children[i], depth = depth + 1}
                    end
                end
            end
        end
    end
end

local function buildDumpRoot()
    local placeName = "Game"
    pcall(function()
        placeName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
    end)
    placeName = sanitizeName(placeName)
    return string.format("%s/%s [%d]", FOLDER_NAME, placeName, game.PlaceId)
end

-- ===================================================================================
-- MODULE 9: Scan (Step-by-Step, allows cancel/rest)
-- ===================================================================================
local scanCancel = false

local function startScan()
    if isScanning then return end
    if not writefile or not makefolder then
        updateStatus("ERROR\nNeed writefile + makefolder")
        return
    end

    isScanning = true
    scanCancel = false
    for k in pairs(stat) do stat[k] = 0 end
    pendingWrites = {}
    canDump = false
    setDumpEnabled(false)

    dumpRoot = buildDumpRoot()
    pcall(makefolder, FOLDER_NAME)
    ensureDir(dumpRoot)

    ScanBtn.Text = "STOP"
    ScanBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
    LogText.Text = "• Scanning (light mode)"
    updateStatus("Scanning...\nPlease wait")
    setProgress(true, 0.05)

    task.spawn(function()
        local targets = {
            {game:GetService("ReplicatedStorage"), "ReplicatedStorage"},
            {game:GetService("ReplicatedFirst"), "ReplicatedFirst"},
            {game:GetService("StarterPlayer"), "StarterPlayer"},
            {game:GetService("StarterGui"), "StarterGui"},
            {game:GetService("StarterPack"), "StarterPack"},
            {LocalPlayer:FindFirstChild("PlayerScripts"), "LocalPlayer/PlayerScripts"},
            {LocalPlayer:FindFirstChild("PlayerGui"), "LocalPlayer/PlayerGui"},
            {workspace, "Workspace"},
        }

        local total = #targets
        for i, data in ipairs(targets) do
            if scanCancel then break end
            local obj, name = data[1], data[2]
            if obj then
                updateStatus(string.format("Scan %d/%d\n%s", i, total, name))
                addLog(name)
                setProgress(true, 0.05 + (i / total) * 0.9)
                scanTree(obj, name:match("^([^/]+)") or name)
            end
            task.wait(0.1)
        end

        local summary = table.concat({
            "=== EGO HUB DUMP ===",
            "PlaceId: " .. tostring(game.PlaceId),
            "Generated: " .. os.date("%Y-%m-%d %H:%M:%S"),
            "Scripts: " .. stat.scripts,
            "  Modules: " .. stat.modules,
            "Remotes: " .. stat.remotes,
            "GUI: " .. stat.gui,
            "Files: " .. stat.files,
            "\nPress DUMP to write files."
        }, "\n")
        queueWrite("_SUMMARY.txt", summary)

        isScanning = false
        ScanBtn.Text = "SCAN"
        ScanBtn.BackgroundColor3 = GREEN_MAIN
        setDumpEnabled(true)
        setProgress(true, 1)
        task.wait(0.3)
        setProgress(false, 0)

        updateStatus(string.format("Done!\nS:%d R:%d G:%d F:%d",
            stat.scripts, stat.remotes, stat.gui, stat.files))
        addLog("Ready: " .. stat.files .. " files")
    end)
end

-- ===================================================================================
-- MODULE 10: Dump (Very slow + safe)
-- ===================================================================================
local function doDump()
    if not canDump or #pendingWrites == 0 then return end
    if not writefile then
        updateStatus("ERROR\nNo writefile")
        return
    end

    DumpBtn.Text = "WRITING..."
    DumpBtn.Active = false
    updateStatus("Writing files...\n0 / " .. #pendingWrites)

    task.spawn(function()
        local total = #pendingWrites
        local written = 0
        for i, item in ipairs(pendingWrites) do
            local dir = item.path:match("(.+)/[^/]+$")
            if dir then ensureDir(dir) end
            pcall(writefile, item.path, item.content)
            written = written + 1
            if i % 10 == 0 or i == total then
                updateStatus(string.format("Writing...\n%d / %d", written, total))
                setProgress(true, written / total)
                task.wait(0.02)
            end
        end

        setProgress(false, 0)
        DumpBtn.Text = "DUMP"
        DumpBtn.Active = true
        updateStatus("SUCCESS!\n" .. dumpRoot)
        addLog("Saved -> " .. dumpRoot)
    end)
end

