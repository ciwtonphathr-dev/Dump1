local decompileCache = setmetatable({}, {__mode = "k"})

local function getScriptSource(obj)
    local cached = decompileCache[obj]
    if cached then return cached end

    local src
    if decompile then
        local ok, res = pcall(decompile, obj)
        if ok and type(res) == "string" and #res > 0 then
            src = res
        end
    end
    if not src then
        local ok2, res2 = pcall(function() return obj.Source end)
        if ok2 and type(res2) == "string" and #res2 > 0 then
            src = res2
        end
    end
    if not src then
        src = "-- [Protected]\n-- Class: " .. obj.ClassName ..
              "\n-- Path: " .. obj:GetFullName() .. "\n"
    end

    decompileCache[obj] = src
    return src
end

-- ===================================================================================
-- MODULE 9: Deep Scanner v4 (Depth 5-6, Adaptive)
-- ===================================================================================
-- ปรับค่าตรงนี้:
local MAX_DEPTH           = 6      -- ลึกสุด 6 ชั้น
local SCAN_PER_FRAME      = 400    -- สแกน 400 object ต่อ yield (สูงขึ้นได้เพราะไม่ decompile ทุกตัว)
local DECOMPILE_BUDGET_MS = 8      -- ใช้เวลา decompile ไม่เกิน 8ms ต่อเฟรม
local MAX_CHILDREN        = 5000   -- ลูกสูงสุดต่อ parent

local function scanTree(root, svc)
    local queueObj   = {root}
    local queueDepth = {0}
    local head = 1
    local tail = 1
    local processed = 0

    while head <= tail do
        if scanCancel then return end

        local obj   = queueObj[head]
        local depth = queueDepth[head]
        head = head + 1

        if obj and depth <= MAX_DEPTH and not ignoreNames[obj.Name] then
            local cls = obj.ClassName

            -- === Script classes ===
            if SCRIPT_CLASSES[cls] then
                stat.scripts = stat.scripts + 1
                if cls == "ModuleScript" then stat.modules = stat.modules + 1 end

                -- decompile แบบจำกัดเวลา
                local t0 = tick()
                local src = getScriptSource(obj)
                local cost = (tick() - t0) * 1000

                enqueueWrite(svc .. "/" .. getRelPath(obj, svc) .. ".lua", src)

                -- ถ้าใช้เวลาเกิน budget ให้ yield ทันที
                if cost >= DECOMPILE_BUDGET_MS then
                    updateStatus(string.format("Scanning...\nS:%d R:%d F:%d",
                        stat.scripts, stat.remotes, stat.files))
                    RunService.Heartbeat:Wait()
                end

            -- === Remote classes ===
            elseif REMOTE_CLASSES[cls] then
                stat.remotes = stat.remotes + 1
                enqueueWrite("Remote/" .. svc .. "/" .. getRelPath(obj, svc) .. ".remote.txt",
                    "ClassName: " .. cls ..
                    "\nName: " .. obj.Name ..
                    "\nPath: " .. obj:GetFullName())

            -- === GUI ===
            elseif cls == "ScreenGui" then
                stat.gui = stat.gui + 1
                enqueueWrite("Gui/" .. svc .. "/" .. getRelPath(obj, svc) .. ".gui.txt",
                    "ClassName: " .. cls ..
                    "\nName: " .. obj.Name ..
                    "\nPath: " .. obj:GetFullName())

            elseif cls == "Humanoid" then
                stat.humanoids = stat.humanoids + 1
            elseif cls == "Tool" then
                stat.tools = stat.tools + 1
            elseif PART_CLASSES[cls] then
                stat.parts = stat.parts + 1
            elseif cls:find("Value") then
                stat.values = stat.values + 1
            end

            -- ดึง children
            if depth < MAX_DEPTH then
                local ok, children = pcall(obj.GetChildren, obj)
                if ok and children then
                    local n = #children
                    if n > MAX_CHILDREN then n = MAX_CHILDREN end
                    for i = 1, n do
                        tail = tail + 1
                        queueObj[tail] = children[i]
                        queueDepth[tail] = depth + 1
                    end
                end
            end

            processed = processed + 1
            if processed % SCAN_PER_FRAME == 0 then
                updateStatus(string.format("Scanning...\nS:%d R:%d F:%d",
                    stat.scripts, stat.remotes, stat.files))
                RunService.Heartbeat:Wait()
            end
        end
    end
end

local function buildDumpRoot()
    local placeName = "Game"
    pcall(function()
        placeName = game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId).Name
    end)
    placeName = sanitizeName(placeName)
    return string.format("%s/%s [%d]", FOLDER_NAME, placeName, game.PlaceId)
end

-- ===================================================================================
-- MODULE 10: Scan Controller
-- ===================================================================================
local function startScan()
    if isScanning then return end
    if not writefile or not makefolder then
        updateStatus("ERROR\nNeed writefile + makefolder")
        return
    end

    isScanning = true
    scanCancel = false
    for k in pairs(stat) do stat[k] = 0 end
    writeQueue = {}
    writeCount = 0
    ensureDirCache = {}
    pathCache = setmetatable({}, {__mode = "k"})
    decompileCache = setmetatable({}, {__mode = "k"})
    canDump = false
    setDumpEnabled(false)

    dumpRoot = buildDumpRoot()
    pcall(makefolder, FOLDER_NAME)
    ensureDir(dumpRoot)
    startWriter()

    ScanBtn.Text = "STOP"
    ScanBtn.BackgroundColor3 = Color3.fromRGB(180, 60, 60)
    logLines = {"• Deep scan (depth 6)"}
    LogText.Text = "• Deep scan (depth 6)"
    updateStatus("Scanning...\nDepth 6 mode")
    setProgress(true, 0.05)

    task.spawn(function()
        -- เรียงลำดับ: เบา → หนัก (เพื่อไม่ให้ค้างตอนเริ่ม)
        local targets = {
            {game:GetService("ReplicatedFirst"), "ReplicatedFirst"},
            {game:GetService("ReplicatedStorage"), "ReplicatedStorage"},
            {game:GetService("StarterGui"), "StarterGui"},
            {game:GetService("StarterPlayer"), "StarterPlayer"},
            {LocalPlayer:FindFirstChild("PlayerScripts"), "LocalPlayer/PlayerScripts"},
            {LocalPlayer:FindFirstChild("PlayerGui"), "LocalPlayer/PlayerGui"},
            {workspace, "Workspace"},
        }

        local total = #targets
        for i, data in ipairs(targets) do
            if scanCancel then break end
            local obj, name = data[1], data[2]
            if obj then
                updateStatus(string.format("Scan %d/%d\n%s", i, total, name))
                addLog(name)
                setProgress(true, 0.05 + (i / total) * 0.9)
                scanTree(obj, name:match("^([^/]+)") or name)
            end
            RunService.Heartbeat:Wait()
        end

        enqueueWrite("_SUMMARY.txt", table.concat({
            "=== EGO HUB DEEP DUMP v4 ===",
            "PlaceId: " .. tostring(game.PlaceId),
            "Depth: " .. MAX_DEPTH,
            "Generated: " .. os.date("%Y-%m-%d %H:%M:%S"),
            "Scripts: " .. stat.scripts,
            "  Modules: " .. stat.modules,
            "Remotes: " .. stat.remotes,
            "GUI: " .. stat.gui,
            "Parts: " .. stat.parts,
            "Values: " .. stat.values,
            "Humanoids: " .. stat.humanoids,
            "Tools: " .. stat.tools,
            "Files: " .. stat.files,
        }, "\n"))

        isScanning = false
        ScanBtn.Text = "SCAN"
        ScanBtn.BackgroundColor3 = GREEN_MAIN
        setDumpEnabled(true)
        setProgress(true, 1)
        task.wait(0.3)
        setProgress(false, 0)

        StatusText.Text = string.format("Done!\nS:%d R:%d G:%d F:%d",
            stat.scripts, stat.remotes, stat.gui, stat.files)
        addLog("Ready: " .. stat.files .. " files")
    end)
end

